{
  "type": "object",
  "required": [
    "comparison_id",
    "run_ids",
    "criada_em",
    "status",
    "avaliacao"
  ],
  "properties": {
    "comparison_id": {
      "type": "string",
      "pattern": "^comp_[0-9a-f]{24}$"
    },
    "run_ids": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "string",
        "pattern": "^[0-9]{12}$"
      }
    },
    "criada_em": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": [
        "pendente",
        "concluida"
      ]
    },
    "avaliacao": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
